{
  "name": "mcp-dm8-server",
  "version": "1.6.2",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "mcp-dm8": "dist/cli.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup src/index.ts src/cli.ts --format esm --dts --out-dir dist",
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "dm8-mcp": "NODE_OPTIONS=--openssl-legacy-provider node dist/index.js",
    "prepublishOnly": "npm run build && npm run test",
    "test": "vitest",
    "test:watch": "vitest --watch",
    "test:coverage": "vitest --coverage",
    "security-audit": "npm audit && npm run test",
    "lint": "eslint src/**/*.ts",
    "format": "prettier --write src/**/*.ts"
  },
  "keywords": [
    "mcp",
    "dm8",
    "dameng",
    "database",
    "mcp-server",
    "security",
    "cli",
    "model-context-protocol"
  ],
  "author": "",
  "license": "ISC",
  "description": "MCP server for DM8 database operations with enhanced security. Provides read-only database access via Model Context Protocol.",
  "repository": {
    "type": "git",
    "url": "https://github.com/Mzaxd/dm8-mcp.git"
  },
  "engines": {
    "node": ">=18.20"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.21.0",
    "dmdb": "1.0.52452",
    "dotenv": "^17.2.3",
    "yargs": "^17.7.2",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/node": "^24.10.0",
    "@vitest/coverage-v8": "^3.2.4",
    "eslint": "^9.0.0",
    "prettier": "^3.3.0",
    "tsup": "^8.5.0",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.65.0",
    "vitest": "^3.2.4"
  }
}
